generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String   @id @default(uuid())
  phone               String   @unique
  email               String?  @unique
  passwordHash        String
  role                String   @default("client")
  firstName           String?
  lastName            String?
  // Provider-only fields
  companyName         String?
  companyRegistration String?
  vatNumber           String?
  serviceArea         String?
  pushToken           String?
  idVerified          Boolean  @default(false)
  idVerifiedAt        DateTime?
  loyaltyPoints       Int      @default(0)
  referralCode        String?  @unique
  referredById        String?
  referralRewarded    Boolean  @default(false)
  createdAt           DateTime @default(now())
}

model LoyaltyRedemption {
  id             String   @id @default(uuid())
  userId         String
  rewardId       String
  pointsSpent    Int
  discountAmount Float
  code           String   @unique
  used           Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([userId])
}

model Provider {
  id              String    @id @default(uuid())
  name            String
  phone           String    @unique
  email           String?
  skills          String[]
  kycStatus       String    @default("pending")
  status          String    @default("pending_kyc")
  rating          Float     @default(0)
  reviewCount     Int       @default(0)
  jobCount        Int       @default(0)
  earningsBalance Float     @default(0)
  monFri          Boolean   @default(true)
  saturday        Boolean   @default(false)
  sunday          Boolean   @default(false)
  emergency       Boolean   @default(false)
  lat             Float?
  lng             Float?
  serviceAreas    String[]
  hireInventory   Json?
  createdAt       DateTime  @default(now())
  bookings        Booking[]
}

model HardwareStore {
  id        String          @id @default(uuid())
  name      String
  email     String          @unique
  phone     String
  address   String
  areas     String[]
  isActive  Boolean         @default(true)
  products  Product[]
  orders    MaterialOrder[]
  createdAt DateTime        @default(now())
}

model Product {
  id          String              @id @default(uuid())
  storeId     String
  store       HardwareStore       @relation(fields: [storeId], references: [id])
  name        String
  category    String
  description String?
  unit        String              @default("each")
  price       Float
  inStock     Boolean             @default(true)
  sku         String?
  createdAt   DateTime            @default(now())
  orderItems  MaterialOrderItem[]
}

model MaterialOrder {
  id          String              @id @default(uuid())
  bookingId   String
  providerId  String
  storeId     String
  store       HardwareStore       @relation(fields: [storeId], references: [id])
  status      String              @default("pending")
  totalAmount Float               @default(0)
  notes       String?
  items       MaterialOrderItem[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model MaterialOrderItem {
  id        String        @id @default(uuid())
  orderId   String
  order     MaterialOrder @relation(fields: [orderId], references: [id])
  productId String
  product   Product       @relation(fields: [productId], references: [id])
  quantity  Float
  unitPrice Float
  total     Float
}

model KycDocument {
  id         String   @id @default(uuid())
  providerId String
  type       String   // 'id' | 'company_reg' | 'bank_letter'
  fileName   String
  fileUrl    String
  status     String   @default("pending") // pending | approved | rejected
  createdAt  DateTime @default(now())

  @@unique([providerId, type])
}

model Message {
  id          String   @id @default(uuid())
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id])
  senderId    String
  senderRole  String   // 'client' | 'provider' | 'admin'
  senderName  String
  text        String   @default("")
  attachments Json?    // [{ url, type: 'image'|'file', fileName }]
  createdAt   DateTime @default(now())
}

model Subscription {
  id           String   @id @default(uuid())
  userId       String
  userRole     String   // 'client' | 'provider'
  planId       String
  status       String   @default("active") // active | cancelled | expired
  peachTokenId String?
  startsAt     DateTime @default(now())
  expiresAt    DateTime?
  cancelledAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, userRole])
}

model Review {
  id         String   @id @default(uuid())
  providerId String
  clientId   String
  bookingId  String?
  stars      Int
  tags       String[]
  comment    String?
  createdAt  DateTime @default(now())

  @@index([providerId])
}

model BankAccount {
  id            String   @id @default(uuid())
  userId        String   @unique
  accountHolder String
  bankName      String
  accountNumber String
  branchCode    String
  accountType   String   @default("cheque")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SavedAddress {
  id        String   @id @default(uuid())
  userId    String
  label     String
  address   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  body      String
  type      String   // new_job | provider_assigned | job_complete | chat_message | payment
  data      Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

model Booking {
  id               String    @id @default(uuid())
  clientId         String
  providerId       String?
  provider         Provider? @relation(fields: [providerId], references: [id])
  serviceType      String
  status           String    @default("pending")
  location         String
  address          String
  quotedAmount     Float
  finalAmount      Float?
  paymentMethod    String    @default("card")
  paymentHeld      Boolean   @default(false)
  paymentReleased  Boolean   @default(false)
  transactionId    String?
  serviceDetails   Json?
  images           String[]
  warrantyExpiresAt DateTime?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  messages         Message[]
}

model SavedCard {
  id          String   @id @default(uuid())
  userId      String
  brand       String
  last4       String
  expiry      String
  holderName  String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId])
}

model Listing {
  id           String   @id @default(uuid())
  sellerId     String
  sellerName   String
  sellerPhone  String
  sellerAvatar String?
  category     String
  subcategory String
  title       String
  description String
  price       Float?
  priceLabel  String
  condition   String?
  images      String[]
  city        String
  suburb      String
  views       Int      @default(0)
  urgent      Boolean  @default(false)
  savedBy     String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([sellerId])
  @@index([city])
}

// ── Freight: truck load management ──────────────────────────────────────────
// Dimensions are stored in the units Google's Routes API expects for
// travelMode TRUCK (millimetres / kilograms) so they pass straight through.

model Truck {
  id            String   @id @default(uuid())
  ownerId       String
  name          String
  plate         String
  driverName    String?
  driverPhone   String?
  driverPhoneKey String? // digits of driverPhone; the driver app matches the signed-in phone against it
  heightMm      Int
  widthMm       Int
  lengthMm      Int
  grossWeightKg Int      // tractor + trailer + max payload
  tareWeightKg  Int      // empty weight; payload capacity = gross - tare
  axleCount     Int      @default(5)
  hazmatTypes   String[] // hazmat classes this rig is certified to haul
  status        String   @default("available") // available | on_load | out_of_service
  // Compliance expiry dates (null = not recorded)
  licenceDiscExpiry   DateTime?
  roadworthyExpiry    DateTime?
  insuranceExpiry     DateTime?
  driverLicenceExpiry DateTime?
  driverPrdpExpiry    DateTime?
  applicationId       String?   // the carrier application it was approved from
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  loads         Load[]

  @@unique([ownerId, plate])
  @@index([ownerId])
  @@index([driverPhoneKey])
}

model Load {
  id               String    @id @default(uuid())
  ownerId          String
  reference        String
  shipperName      String
  commodity        String
  weightKg         Int
  hazmatTypes      String[]
  rate             Float?
  originAddress    String
  originLat        Float?
  originLng        Float?
  destAddress      String
  destLat          Float?
  destLng          Float?
  pickupAt         DateTime?
  deliverBy        DateTime?
  status           String    @default("booked") // booked | assigned | in_transit | delivered | cancelled
  notes            String?
  truckId          String?
  truck            Truck?    @relation(fields: [truckId], references: [id])
  shipmentId       String?   // set when won on the marketplace. Not @unique: adding a unique
                             // constraint to an existing table makes `db push` refuse at deploy.
  deliveredByKey   String?   // driver phone key at delivery, so history follows the driver, not the truck
  // Cached truck route from Google Routes API (travelMode TRUCK)
  routeDistanceM   Int?
  routeDurationS   Int?
  routePolyline    String?
  routeWarnings    String[]
  routeComputedAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  events           LoadEvent[]

  @@unique([ownerId, reference])
  @@index([ownerId, status])
  @@index([truckId])
  @@index([deliveredByKey])
  @@index([shipmentId])
}

model LoadEvent {
  id        String   @id @default(uuid())
  loadId    String
  load      Load     @relation(fields: [loadId], references: [id], onDelete: Cascade)
  type      String   // created | assigned | unassigned | status | routed
  actor     String   @default("dispatcher") // dispatcher | driver
  message   String
  createdAt DateTime @default(now())

  @@index([loadId])
}

// ── Truck Loads: carrier / driver applications ──────────────────────────────
// Each dispatcher shares a private link; anyone with it can apply with their
// truck, driver and compliance documents. Approving creates the Truck (and a
// driver-app login) in that dispatcher's fleet.

model ApplicationLink {
  id        String   @id @default(uuid())
  ownerId   String
  token     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  applications TruckApplication[]

  @@index([ownerId, active])
}

model TruckApplication {
  id             String    @id @default(uuid())
  ownerId        String
  linkId         String
  link           ApplicationLink @relation(fields: [linkId], references: [id])
  reference      String    @unique // short code shown to the applicant, e.g. TL-7K3M9Q
  status         String    @default("pending") // pending | approved | rejected
  // Company / contact
  companyName    String?
  contactName    String
  contactPhone   String
  contactEmail   String?
  // Driver
  driverName     String
  driverPhone    String
  driverIdNumber String
  licenceCode    String
  licenceExpiry  DateTime
  prdpExpiry     DateTime?
  discExpiry       DateTime?
  roadworthyExpiry DateTime?
  insuranceExpiry  DateTime?
  passwordHash   String?   // driver-app password chosen on the form; used on approval
  // Truck
  truckType      String
  make           String
  model          String?
  year           Int?
  plate          String
  vin            String?
  heightMm       Int
  widthMm        Int
  lengthMm       Int
  grossWeightKg  Int
  tareWeightKg   Int
  axleCount      Int
  hazmatTypes    String[]
  // Review
  consentAt      DateTime  // POPIA consent to process personal information
  reviewNote     String?
  reviewedAt     DateTime?
  truckId        String?   // set when approved
  createdAt      DateTime  @default(now())
  documents      ApplicationDocument[]

  @@index([ownerId, status])
}

model ApplicationDocument {
  id            String   @id @default(uuid())
  applicationId String
  application   TruckApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  kind          String   // see APPLICATION_DOCUMENTS
  fileName      String
  mimeType      String
  size          Int
  // Stored in the database (not a public URL): these include ID documents
  data          Bytes
  createdAt     DateTime @default(now())

  @@index([applicationId])
}

// ── Truck Loads: carrier company verification (platform level) ─────────────
// A carrier (fleet owner / dispatcher account) submits company documents; a
// platform admin verifies them. The Verified badge is what shippers trust.

model CarrierProfile {
  id                 String    @id @default(uuid())
  ownerId            String    @unique
  companyName        String
  registrationNumber String    // CIPC
  vatNumber          String?
  contactName        String
  contactPhone       String
  contactEmail       String?
  address            String?
  status             String    @default("draft") // draft | pending | verified | rejected
  reviewNote         String?
  submittedAt        DateTime?
  verifiedAt         DateTime?
  lastComplianceSmsAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  documents          CarrierDocument[]

  @@index([status])
}

model CarrierDocument {
  id        String    @id @default(uuid())
  profileId String
  profile   CarrierProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  kind      String    // see CARRIER_DOCUMENTS
  fileName  String
  mimeType  String
  size      Int
  data      Bytes
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@unique([profileId, kind])
}

// ── Truck Loads marketplace: shippers post, carriers bid (RFQ) ──────────────

model ShipperProfile {
  id           String   @id @default(uuid())
  ownerId      String   @unique
  companyName  String
  contactName  String
  contactPhone String
  contactEmail String?
  vatNumber    String?
  address      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Shipment {
  id              String    @id @default(uuid())
  shipperId       String    // User id of the shipper
  reference       String    @unique // SH-XXXXXX
  commodity       String
  weightKg        Int
  hazmatTypes     String[]
  truckType       String?   // preferred truck type
  originAddress   String
  destAddress     String
  pickupAt        DateTime?
  deliverBy       DateTime?
  notes           String?
  targetRate      Float?    // shipper's budget, shown to carriers
  verifiedOnly    Boolean   @default(true)
  biddingClosesAt DateTime?
  status          String    @default("open") // open | awarded | in_transit | delivered | cancelled
  awardedBidId    String?   @unique
  loadId          String?   @unique // the carrier's Load once awarded
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  bids            Bid[]

  @@index([status, createdAt])
  @@index([shipperId])
}

model Bid {
  id         String   @id @default(uuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  carrierId  String   // User id of the carrier (fleet owner)
  amount     Float
  message    String?
  status     String   @default("active") // active | withdrawn | accepted | declined
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([shipmentId, carrierId])
  @@index([carrierId])
}
