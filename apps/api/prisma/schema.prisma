generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String   @id @default(uuid())
  phone               String   @unique
  email               String?  @unique
  passwordHash        String
  role                String   @default("client")
  firstName           String?
  lastName            String?
  // Provider-only fields
  companyName         String?
  companyRegistration String?
  vatNumber           String?
  serviceArea         String?
  pushToken           String?
  idVerified          Boolean  @default(false)
  idVerifiedAt        DateTime?
  loyaltyPoints       Int      @default(0)
  referralCode        String?  @unique
  referredById        String?
  referralRewarded    Boolean  @default(false)
  createdAt           DateTime @default(now())
}

model LoyaltyRedemption {
  id             String   @id @default(uuid())
  userId         String
  rewardId       String
  pointsSpent    Int
  discountAmount Float
  code           String   @unique
  used           Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([userId])
}

model Provider {
  id              String    @id @default(uuid())
  name            String
  phone           String    @unique
  email           String?
  skills          String[]
  kycStatus       String    @default("pending")
  status          String    @default("pending_kyc")
  rating          Float     @default(0)
  reviewCount     Int       @default(0)
  jobCount        Int       @default(0)
  earningsBalance Float     @default(0)
  monFri          Boolean   @default(true)
  saturday        Boolean   @default(false)
  sunday          Boolean   @default(false)
  emergency       Boolean   @default(false)
  lat             Float?
  lng             Float?
  serviceAreas    String[]
  hireInventory   Json?
  createdAt       DateTime  @default(now())
  bookings        Booking[]
}

model HardwareStore {
  id        String          @id @default(uuid())
  name      String
  email     String          @unique
  phone     String
  address   String
  areas     String[]
  isActive  Boolean         @default(true)
  products  Product[]
  orders    MaterialOrder[]
  createdAt DateTime        @default(now())
}

model Product {
  id          String              @id @default(uuid())
  storeId     String
  store       HardwareStore       @relation(fields: [storeId], references: [id])
  name        String
  category    String
  description String?
  unit        String              @default("each")
  price       Float
  inStock     Boolean             @default(true)
  sku         String?
  createdAt   DateTime            @default(now())
  orderItems  MaterialOrderItem[]
}

model MaterialOrder {
  id          String              @id @default(uuid())
  bookingId   String
  providerId  String
  storeId     String
  store       HardwareStore       @relation(fields: [storeId], references: [id])
  status      String              @default("pending")
  totalAmount Float               @default(0)
  notes       String?
  items       MaterialOrderItem[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model MaterialOrderItem {
  id        String        @id @default(uuid())
  orderId   String
  order     MaterialOrder @relation(fields: [orderId], references: [id])
  productId String
  product   Product       @relation(fields: [productId], references: [id])
  quantity  Float
  unitPrice Float
  total     Float
}

model KycDocument {
  id         String   @id @default(uuid())
  providerId String
  type       String   // 'id' | 'company_reg' | 'bank_letter'
  fileName   String
  fileUrl    String
  status     String   @default("pending") // pending | approved | rejected
  createdAt  DateTime @default(now())

  @@unique([providerId, type])
}

model Message {
  id          String   @id @default(uuid())
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id])
  senderId    String
  senderRole  String   // 'client' | 'provider' | 'admin'
  senderName  String
  text        String   @default("")
  attachments Json?    // [{ url, type: 'image'|'file', fileName }]
  createdAt   DateTime @default(now())
}

model Subscription {
  id           String   @id @default(uuid())
  userId       String
  userRole     String   // 'client' | 'provider'
  planId       String
  status       String   @default("active") // active | cancelled | expired
  peachTokenId String?
  startsAt     DateTime @default(now())
  expiresAt    DateTime?
  cancelledAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, userRole])
}

model Review {
  id         String   @id @default(uuid())
  providerId String
  clientId   String
  bookingId  String?
  stars      Int
  tags       String[]
  comment    String?
  createdAt  DateTime @default(now())

  @@index([providerId])
}

model BankAccount {
  id            String   @id @default(uuid())
  userId        String   @unique
  accountHolder String
  bankName      String
  accountNumber String
  branchCode    String
  accountType   String   @default("cheque")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SavedAddress {
  id        String   @id @default(uuid())
  userId    String
  label     String
  address   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  body      String
  type      String   // new_job | provider_assigned | job_complete | chat_message | payment
  data      Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

model Booking {
  id               String    @id @default(uuid())
  clientId         String
  providerId       String?
  provider         Provider? @relation(fields: [providerId], references: [id])
  serviceType      String
  status           String    @default("pending")
  location         String
  address          String
  quotedAmount     Float
  finalAmount      Float?
  paymentMethod    String    @default("card")
  paymentHeld      Boolean   @default(false)
  paymentReleased  Boolean   @default(false)
  transactionId    String?
  serviceDetails   Json?
  images           String[]
  warrantyExpiresAt DateTime?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  messages         Message[]
}

model SavedCard {
  id          String   @id @default(uuid())
  userId      String
  brand       String
  last4       String
  expiry      String
  holderName  String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId])
}

model Listing {
  id           String   @id @default(uuid())
  sellerId     String
  sellerName   String
  sellerPhone  String
  sellerAvatar String?
  category     String
  subcategory String
  title       String
  description String
  price       Float?
  priceLabel  String
  condition   String?
  images      String[]
  city        String
  suburb      String
  views       Int      @default(0)
  urgent      Boolean  @default(false)
  savedBy     String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([sellerId])
  @@index([city])
}

// ── Freight: truck load management ──────────────────────────────────────────
// Dimensions are stored in the units Google's Routes API expects for
// travelMode TRUCK (millimetres / kilograms) so they pass straight through.

model Truck {
  id            String   @id @default(uuid())
  ownerId       String
  name          String
  plate         String
  driverName    String?
  driverPhone   String?
  heightMm      Int
  widthMm       Int
  lengthMm      Int
  grossWeightKg Int      // tractor + trailer + max payload
  tareWeightKg  Int      // empty weight; payload capacity = gross - tare
  axleCount     Int      @default(5)
  hazmatTypes   String[] // hazmat classes this rig is certified to haul
  status        String   @default("available") // available | on_load | out_of_service
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  loads         Load[]

  @@unique([ownerId, plate])
  @@index([ownerId])
}

model Load {
  id               String    @id @default(uuid())
  ownerId          String
  reference        String
  shipperName      String
  commodity        String
  weightKg         Int
  hazmatTypes      String[]
  rate             Float?
  originAddress    String
  originLat        Float?
  originLng        Float?
  destAddress      String
  destLat          Float?
  destLng          Float?
  pickupAt         DateTime?
  deliverBy        DateTime?
  status           String    @default("booked") // booked | assigned | in_transit | delivered | cancelled
  notes            String?
  truckId          String?
  truck            Truck?    @relation(fields: [truckId], references: [id])
  // Cached truck route from Google Routes API (travelMode TRUCK)
  routeDistanceM   Int?
  routeDurationS   Int?
  routePolyline    String?
  routeWarnings    String[]
  routeComputedAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  events           LoadEvent[]

  @@unique([ownerId, reference])
  @@index([ownerId, status])
  @@index([truckId])
}

model LoadEvent {
  id        String   @id @default(uuid())
  loadId    String
  load      Load     @relation(fields: [loadId], references: [id], onDelete: Cascade)
  type      String   // created | assigned | unassigned | status | routed
  message   String
  createdAt DateTime @default(now())

  @@index([loadId])
}
