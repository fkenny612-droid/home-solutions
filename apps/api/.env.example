# Application
PORT=4000
NODE_ENV=development
WEB_URL=http://localhost:3000

# JWT
JWT_SECRET=change-me-in-production

# Database (when ready to connect PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/home_solutions

# Peach Payments
# Get credentials from https://developer.peachpayments.com
PEACH_MODE=test
PEACH_ENTITY_ID=your-entity-id-here
PEACH_ACCESS_TOKEN=your-access-token-here

# Firebase (push notifications)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-service-account-email
FIREBASE_PRIVATE_KEY=your-private-key

# Africa's Talking SMS
AT_API_KEY=your-at-api-key
AT_USERNAME=sandbox

# ── Truck Loads ─────────────────────────────────────────────────────────────
# Public URL of this API (payment provider webhooks call back here)
API_PUBLIC_URL=http://localhost:4000
# Routes API key for truck routing (leave empty to disable route planning)
GOOGLE_MAPS_API_KEY=
# Marketplace payments: peach (live) | test (fake checkout, no real money) | off
# Production defaults to "off" when unset, so shippers can't "pay" with the test checkout.
PAYMENTS_MODE=test
PLATFORM_FEE_PERCENT=5
CLAIM_WINDOW_HOURS=48
# Peach Checkout (only when PAYMENTS_MODE=peach)
PEACH_CLIENT_ID=
PEACH_CLIENT_SECRET=
PEACH_MERCHANT_ID=
PEACH_WEBHOOK_SECRET=
# Set to "off" to stop the hourly compliance SMS digest / escrow release job
TRUCK_LOADS_ALERTS=on
TRUCK_LOADS_JOBS=on
